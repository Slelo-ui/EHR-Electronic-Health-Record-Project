{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run desktop app",
      "type": "shell",
      "command": "cargo tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/src/Ehr.Desktop/src-tauri"
      },
      "problemMatcher": []
    },
    {
      "label": "Run web app",
      "type": "shell",
      "command": "dotnet run --project src/Ehr.Web",
      "problemMatcher": "$msCompile"
    }
  ]
}
