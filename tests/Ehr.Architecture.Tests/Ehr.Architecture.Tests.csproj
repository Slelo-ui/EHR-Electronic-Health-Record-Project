<Project Sdk="Microsoft.NET.Sdk">

  <!-- CI gates: each layer calls only the one below it; PHI reads go only through the PHI reader. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- No tests yet, and "zero tests ran" fails `dotnet test` (exit code 8). Remove with the first test. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ehr.Web\Ehr.Web.csproj" />
  </ItemGroup>

</Project>
